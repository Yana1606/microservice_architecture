  "components": {
    "schemas": {
      "TaskRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "correct": {
            "type": "number"
          },
          "incorrect": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "statement",
          "reference",
          "correct",
          "incorrect"
        ]
      },
      "GameConfig": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskRule"
            }
          },
          "modifiers": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "solutionSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "appealSeconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "type",
          "tasks",
          "modifiers",
          "solutionSeconds",
          "appealSeconds"
        ]
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "captain": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "captain",
          "members"
        ]
      },
      "Tournament": {

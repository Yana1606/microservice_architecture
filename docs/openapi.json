          "correlationId": {
            "type": "string"
          },
          "causationId": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "version",
          "type",
          "producer",
          "tournamentId",
          "gameId",
          "occurredAt",
          "correlationId",
          "causationId",
          "data"
        ]

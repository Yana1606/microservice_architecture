            "type": "string",
            "format": "date-time"
          },
          "ends": {
            "type": "string",
            "format": "date-time"
          },
          "teamSize": {
            "type": "integer",
            "enum": [
              4
            ]
          },
          "jury": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "senior": {
            "type": "string"
          },
          "regulation": {
            "type": "string"
          },
          "tiePolicy": {
            "type": "string",
            "enum": [
              "SharedCompetition"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "starts",
          "ends",
          "teamSize",
          "jury",
          "senior",
          "regulation",
          "tiePolicy"
        ]
      },
